{
  "remarks": "Dr Serverless",
  "log": {
    "loglevel": "warning"
  },
  "dns": {
    "tag": "dns-module",
    "queryStrategy": "UseIPv4",
    "servers": [
      "https://8.8.8.8/dns-query",
      "https://1.1.1.1/dns-query"
    ]
  },
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIPv4",
        "fragment": {
          "packets": "tlshello",
          "length": "10-20",
          "interval": "10-20"
        }
      },
      "streamSettings": {
        "sockopt": {
          "tcpNoDelay": true
        }
      }
    },
    {
      "tag": "dns-out",
      "protocol": "dns"
    },
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "inboundTag": ["dns-module"],
        "outboundTag": "proxy"
      },
      {
        "type": "field",
        "port": "53",
        "outboundTag": "dns-out"
      },
      {
        "type": "field",
        "network": "udp",
        "port": "443",
        "outboundTag": "block"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "proxy"
      }
    ]
  }
}
