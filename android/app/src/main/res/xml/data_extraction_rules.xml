<?xml version="1.0" encoding="utf-8"?>
<!-- Protected stores are encrypted with a device-bound Keystore key, so copying them to another
     device would leave them unreadable. Use the in-app backup instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="mmkv" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="mmkv" />
    </device-transfer>
</data-extraction-rules>
